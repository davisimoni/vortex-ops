# ---------------------------------------------------------------------------
# Vortex Ops — environment
# Copy to `.env.local` for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Deployment identity, stamped into every structured log line.
VORTEX_SERVICE_NAME=vortex-ops
VORTEX_ENV=development
VORTEX_REGION=eu-central-1

# Log verbosity: debug | info | warn | error
LOG_LEVEL=debug
# Set to "1" to emit human-readable logs locally instead of one JSON object per line.
LOG_PRETTY=1

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
# Unset → the app falls back to an in-process store automatically. Data is
# lost on restart, but the build, dev server and tests all still work with no
# database at all. Set this to enable real persistence:
#   SQLite (zero setup):      file:./prisma/dev.db
#   Postgres / Supabase:      postgresql://user:pass@host:5432/db?sslmode=require
# Postgres requires the matching schema: npm run db:push:postgres
DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth & secrets — required in production, optional in development
# ---------------------------------------------------------------------------
# Signs session cookies (HMAC-SHA256). 32+ characters.
# Missing in production → the app refuses to boot. Missing in development →
# an ephemeral per-process secret is generated, with a warning; sessions do
# not survive a restart. Generate with: openssl rand -base64 48
VORTEX_SESSION_SECRET=

# Encrypts third-party credentials at rest (Discord webhook URLs, Telegram bot
# tokens, PagerDuty routing keys) with AES-256-GCM. 64 hex chars (32 bytes).
# Missing → integrations that need a credential are refused with a 503 rather
# than stored in plaintext. Falls back to deriving a key from
# VORTEX_SESSION_SECRET if that is set and this is not.
# Generate with: openssl rand -hex 32
VORTEX_ENCRYPTION_KEY=

# Password for every seeded demo account. Unset locally → "vortex-demo-2026"
# (shown on the sign-in page). MUST be set in any deployed environment — the
# app refuses to seed demo accounts in production without it.
VORTEX_DEMO_PASSWORD=

# Skip fixture seeding entirely (e.g. once real customer data exists).
VORTEX_SKIP_SEED=

# Shared secret used to sign outbound custom-webhook payloads (HMAC-SHA256,
# header `X-Vortex-Signature`). Generate with: openssl rand -hex 32
VORTEX_WEBHOOK_SIGNING_SECRET=

# Outbound mail relay for the email integration. Unset, email test sends return
# 503 with an actionable message rather than reporting a success for a message
# that never left the building.
VORTEX_MAIL_RELAY_URL=

# Allow webhook delivery tests to hit private/loopback addresses.
# Development convenience ONLY — leave unset in any deployed environment,
# otherwise the SSRF guard is disabled. Also hard-ignored whenever
# VORTEX_ENV=production, regardless of this value.
VORTEX_ALLOW_PRIVATE_WEBHOOK_HOSTS=
