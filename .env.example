# ---------------------------------------------------------------------------
# Vortex Ops — environment
# Copy to `.env.local` for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Deployment identity, stamped into every structured log line.
VORTEX_SERVICE_NAME=vortex-ops
VORTEX_ENV=development
VORTEX_REGION=eu-central-1

# Public base URL, used only to resolve absolute og:image/twitter:image URLs
# (see src/app/og/route.tsx). Unset → localhost, which is fine in development
# but means a shared link's social preview breaks on a real deployment.
NEXT_PUBLIC_APP_URL=

# Log verbosity: debug | info | warn | error
LOG_LEVEL=debug
# Set to "1" to emit human-readable logs locally instead of one JSON object per line.
LOG_PRETTY=1

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
# Unset → falls back automatically. On a normal filesystem (local dev, a VPS,
# a container with a volume) that means a local SQLite file — `npm run db:push`
# once, and it is found and used with no DATABASE_URL needed at all. On Vercel
# specifically it means in-memory: the deployed filesystem is read-only outside
# /tmp, so a local file can never really persist there — see the callout in
# README.md under "Authentication & sessions" for why that same platform
# distinction matters for VORTEX_SESSION_SECRET too. Set this to use a real
# database explicitly instead:
#   SQLite (zero setup):      file:./dev.db   — relative to prisma/schema.prisma,
#                              NOT the project root; despite `npm run db:push`
#                              printing "prisma/dev.db", file:./prisma/dev.db
#                              silently fails to connect.
#   Postgres / Supabase:      postgresql://user:pass@host:5432/db?sslmode=require
#                              — REQUIRED on Vercel for persistence that survives
#                              a reload; Vercel Postgres, Neon and Supabase all
#                              have first-class Vercel integrations.
# Postgres requires the matching schema: npm run db:push:postgres
DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth & secrets — required in production, optional in development
# ---------------------------------------------------------------------------
# Signs session cookies (HMAC-SHA256). 32+ characters.
#
# REQUIRED on Vercel (or any platform that runs more than one instance of the
# app). Detected automatically via VERCEL_ENV, not only via VORTEX_ENV below —
# see isProductionDeployment() in src/lib/runtime-env.ts — so this is not
# something you have to remember to opt into. Missing there, the app does NOT
# refuse to boot: it falls back to a per-process ephemeral secret, and on a
# serverless platform each instance generates its own random one, so a session
# cookie signed by one instance fails to verify on the next request if it
# lands on another. With this app's no-sign-in-wall demo flow retrying
# automatically on every failed session, that is ERR_TOO_MANY_REDIRECTS in the
# browser, not a clear error. GET /api/health reports this under the
# "session_secret" check either way.
#
# Missing in local development → the same ephemeral fallback, with a warning;
# fine for one long-running process. Generate with: openssl rand -base64 48
VORTEX_SESSION_SECRET=

# Encrypts third-party credentials at rest (Discord webhook URLs, Telegram bot
# tokens, PagerDuty routing keys) with AES-256-GCM. 64 hex chars (32 bytes).
# Missing → integrations that need a credential are refused with a 503 rather
# than stored in plaintext. Falls back to deriving a key from
# VORTEX_SESSION_SECRET if that is set and this is not.
# Generate with: openssl rand -hex 32
VORTEX_ENCRYPTION_KEY=

# Password for every seeded demo account. Unset locally → "vortex-demo-2026"
# (shown on the sign-in page). Refused only when VORTEX_ENV=production is set
# explicitly below — deliberately NOT auto-detected from a bare Vercel
# deployment the way VORTEX_SESSION_SECRET is: this app's whole premise is a
# publicly known demo password shown right on the sign-in page, so a portfolio
# deployment on Vercel with no VORTEX_ENV set is expected to keep using the
# default. Set VORTEX_ENV=production explicitly (and this) if you fork this
# into something that is not meant to be a public demo.
VORTEX_DEMO_PASSWORD=

# Skip fixture seeding entirely (e.g. once real customer data exists).
VORTEX_SKIP_SEED=

# Shared secret used to sign outbound custom-webhook payloads (HMAC-SHA256,
# header `X-Vortex-Signature`). Generate with: openssl rand -hex 32
VORTEX_WEBHOOK_SIGNING_SECRET=

# Outbound mail relay for the email integration. Unset, email test sends return
# 503 with an actionable message rather than reporting a success for a message
# that never left the building.
VORTEX_MAIL_RELAY_URL=

# Allow webhook delivery tests to hit private/loopback addresses.
# Development convenience ONLY — leave unset in any deployed environment,
# otherwise the SSRF guard is disabled. Hard-ignored on any real deployment,
# detected the same Vercel-aware way as VORTEX_SESSION_SECRET above (VORTEX_ENV
# or VERCEL_ENV), regardless of this value.
VORTEX_ALLOW_PRIVATE_WEBHOOK_HOSTS=
